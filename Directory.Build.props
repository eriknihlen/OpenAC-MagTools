<Project>
  <PropertyGroup>
    <!-- Repository-wide language and warning policy, matching OpenAC. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>

    <!-- Where OpenAC's source lives: the plugin compiles against
         src/AcDream.Plugin.Abstractions there. The plugin API this plugin uses
         is on OpenAC main since 2026-09-17, so the default is a checkout of
         main. Override with -p:OpenAcRoot=<path> if yours is elsewhere. -->
    <OpenAcRoot Condition="'$(OpenAcRoot)' == ''">C:\Users\erikn\source\repos\acdream\OpenAC\</OpenAcRoot>
  </PropertyGroup>
</Project>
